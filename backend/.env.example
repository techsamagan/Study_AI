# Copy this file to .env and fill in the values:  cp .env.example .env

# --- Django -----------------------------------------------------------------
# True for local development only. Must be False (or unset) in production.
DEBUG=True
# Required when DEBUG is off. Generate one with: python generate_secret_key.py
SECRET_KEY=
# Comma-separated hostnames this backend is served from.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------------
# "postgresql" (default) or "sqlite" for a zero-setup local run.
DB_ENGINE=postgresql
DB_NAME=ai_learning_assistant
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
# docker-compose.yml publishes PostgreSQL on 5434 to avoid clashing with a
# locally installed PostgreSQL on 5432.
DB_PORT=5434

# --- OpenAI -----------------------------------------------------------------
# Required for summaries and flashcard generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Frontend origins -------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Needed in production to log in to /admin/ over HTTPS, e.g. https://api.example.com
CSRF_TRUSTED_ORIGINS=

# --- Optional tuning --------------------------------------------------------
# THROTTLE_AUTH=10/min
# THROTTLE_AI=30/hour
# AI_MAX_INPUT_CHARS=60000
# OPENAI_TIMEOUT_SECONDS=90
